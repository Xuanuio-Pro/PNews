PNEWS_APP_ENV=production
PNEWS_HOST=0.0.0.0
PNEWS_PORT=8000
PNEWS_DATA_DIR=data
PNEWS_LOG_DIR=logs
PNEWS_DATABASE_PATH=data/cms.sqlite3
PNEWS_ADMIN_ACCOUNTS={"admin":"your_strong_password"}

# Domain + HTTPS qua Nginx/Cloudflare DNS challenge
PNEWS_DOMAIN=
PNEWS_WWW_DOMAIN=
PNEWS_CERTBOT_EMAIL=
CLOULDFARE_TOKEN=
# Tùy chọn: alias viết đúng chính tả, script ưu tiên CLOULDFARE_TOKEN theo yêu cầu ở trên.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DNS_PROPAGATION_SECONDS=60
PNEWS_DISABLE_DEFAULT_NGINX_SITE=1

# Cloudflare Tunnel connector
PNEWS_TUNNEL_HOSTNAME=
PNEWS_TUNNEL_HEALTH_URL=http://127.0.0.1:8000/health
CLOUDFLARE_TUNNEL_TOKEN=
# Alias viết lệch để tương thích nếu bạn quen dùng CLOULDFARE.
CLOULDFARE_TUNNEL_TOKEN=

# Cấu hình Facebook Page
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v25.0

# Cấu hình Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API keys cho AI (Gemini / Groq)
GEMINI_API_KEY=
GROQ_API_KEY=
